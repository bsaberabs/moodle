<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/oriskill/db" VERSION="20261030" COMMENT="XMLDB file for local/oriskill"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_oriskill_creators" COMMENT="Trainer spaces: one per trainer, with its own course category and public showcase">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Trainer account"/>
        <FIELD NAME="slug" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false" COMMENT="Showcase address /f/slug and future subdomain"/>
        <FIELD NAME="displayname" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="tagline" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="bio" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="bioformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="motivation" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Application message, read by the administrator"/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Course category created on approval"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending, active, suspended, rejected"/>
        <FIELD NAME="sap_siteid" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="Trainer's SecureAndPay IdSite: their sales are paid into their own account"/>
        <FIELD NAME="sap_key" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Trainer's SecureAndPay signing key, encrypted with core\encryption"/>
        <FIELD NAME="sap_testmode" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Use the SecureAndPay test environment"/>
        <FIELD NAME="affiliaterate" TYPE="number" LENGTH="5" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false" COMMENT="Commission (%) paid by the trainer to affiliates on their courses; 0 = no affiliation"/>
        <FIELD NAME="primarycolor" TYPE="char" LENGTH="7" NOTNULL="false" SEQUENCE="false" COMMENT="Showcase main colour (#rrggbb); empty = Oriskill's"/>
        <FIELD NAME="accentcolor" TYPE="char" LENGTH="7" NOTNULL="false" SEQUENCE="false" COMMENT="Showcase accent colour (#rrggbb)"/>
        <FIELD NAME="fontstyle" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Showcase typeface: modern, elegant or classic"/>
        <FIELD NAME="customdomain" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Own domain that opens the showcase (lowercase, no www)"/>
        <FIELD NAME="legalname" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Seller name on invoices (company or person)"/>
        <FIELD NAME="legaladdress" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="siret" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false" COMMENT="SIRET or other registration number"/>
        <FIELD NAME="vatnumber" TYPE="char" LENGTH="30" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="vatrate" TYPE="number" LENGTH="5" NOTNULL="false" DECIMALS="2" SEQUENCE="false" COMMENT="VAT included in prices, in %; null or 0: not subject to VAT (franchise)"/>
        <FIELD NAME="invoicenotes" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Mentions printed at the bottom of invoices"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign-unique" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="categoryid" TYPE="foreign" FIELDS="categoryid" REFTABLE="course_categories" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="slug" UNIQUE="true" FIELDS="slug"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="customdomain" UNIQUE="false" FIELDS="customdomain"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oriskill_affiliates" COMMENT="Affiliates: users who earn a commission on the sales they bring">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="code" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="Referral code, used as ?ref=code"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="active" SEQUENCE="false" COMMENT="active, suspended"/>
        <FIELD NAME="clicks" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Visits through the affiliate's links"/>
        <FIELD NAME="payoutdetails" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="How the affiliate wants to be paid (IBAN, PayPal...)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign-unique" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="code" UNIQUE="true" FIELDS="code"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oriskill_referrals" COMMENT="Orders placed after following an affiliate link">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="orderid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="affiliateid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="orderid" TYPE="foreign-unique" FIELDS="orderid" REFTABLE="local_moderncommerce_orders" REFFIELDS="id"/>
        <KEY NAME="affiliateid" TYPE="foreign" FIELDS="affiliateid" REFTABLE="local_oriskill_affiliates" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_oriskill_commissions" COMMENT="Affiliate commissions, one per paid order line">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="affiliateid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="orderid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="orderitemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sellerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Trainer who owes the commission (local_oriskill_creators.id), 0 = Oriskill"/>
        <FIELD NAME="itemname" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="base" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="6" SEQUENCE="false" COMMENT="Amount paid for the line, before tax and after discounts"/>
        <FIELD NAME="rate" TYPE="number" LENGTH="5" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false"/>
        <FIELD NAME="amount" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="6" SEQUENCE="false" COMMENT="Commission"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending (refund window), approved (due), paid, cancelled"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timepaid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="affiliateid" TYPE="foreign" FIELDS="affiliateid" REFTABLE="local_oriskill_affiliates" REFFIELDS="id"/>
        <KEY NAME="orderid" TYPE="foreign" FIELDS="orderid" REFTABLE="local_moderncommerce_orders" REFFIELDS="id"/>
        <KEY NAME="orderitemid" TYPE="foreign-unique" FIELDS="orderitemid" REFTABLE="local_moderncommerce_order_items" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="sellerid" UNIQUE="false" FIELDS="sellerid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oriskill_gateways" COMMENT="Trainers' own Stripe and PayPal accounts, used for their courses">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="creatorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="gateway" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="stripe or paypal"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="testmode" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Stripe test keys / PayPal sandbox"/>
        <FIELD NAME="publickey" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Stripe publishable key or PayPal client ID"/>
        <FIELD NAME="secretkey" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Stripe secret key or PayPal secret, encrypted"/>
        <FIELD NAME="webhooksecret" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Stripe signing secret (encrypted) or PayPal webhook ID"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="creatorid" TYPE="foreign" FIELDS="creatorid" REFTABLE="local_oriskill_creators" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="creatorgateway" UNIQUE="true" FIELDS="creatorid, gateway"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oriskill_instoffers" COMMENT="Payment in instalments offered by a trainer for a course">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="count" TYPE="int" LENGTH="3" NOTNULL="true" SEQUENCE="false" COMMENT="Monthly instalments"/>
        <FIELD NAME="total" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false" COMMENT="Total price paid in instalments"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign-unique" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_oriskill_instalments" COMMENT="Purchases of a trainer course paid in instalments, and where their payments stand">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="orderid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="count" TYPE="int" LENGTH="3" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="amount" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false" COMMENT="Each instalment"/>
        <FIELD NAME="firstamount" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false" COMMENT="First instalment when it differs from the others, 0 when equal"/>
        <FIELD NAME="paid" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Instalments received"/>
        <FIELD NAME="status" TYPE="char" LENGTH="15" NOTNULL="true" DEFAULT="active" SEQUENCE="false" COMMENT="active, late (refused, grace period), suspended (access suspended), stopped (schedule ended unpaid, grace period), completed"/>
        <FIELD NAME="latesince" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="First unpaid instalment, 0 when up to date"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="orderid" TYPE="foreign-unique" FIELDS="orderid" REFTABLE="local_moderncommerce_orders" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oriskill_invoices" COMMENT="Invoices and credit notes issued in a trainer's name, numbered per trainer">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="creatorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="orderid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Buyer"/>
        <FIELD NAME="type" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="invoice or credit"/>
        <FIELD NAME="sequence" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Continuous number per trainer and type"/>
        <FIELD NAME="number" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="parentid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Invoice a credit note cancels"/>
        <FIELD NAME="total" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false" COMMENT="Amount including VAT, positive for both types"/>
        <FIELD NAME="tax" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false"/>
        <FIELD NAME="currency" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="data" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="JSON snapshot: seller, buyer, lines, mentions (a document never changes once issued)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="creatorid" TYPE="foreign" FIELDS="creatorid" REFTABLE="local_oriskill_creators" REFFIELDS="id"/>
        <KEY NAME="orderid" TYPE="foreign" FIELDS="orderid" REFTABLE="local_moderncommerce_orders" REFFIELDS="id"/>
        <KEY NAME="parentid" TYPE="foreign" FIELDS="parentid" REFTABLE="local_oriskill_invoices" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="creatortypesequence" UNIQUE="true" FIELDS="creatorid, type, sequence"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oriskill_members" COMMENT="Collaborators of a trainer, with their role in the trainer space">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="creatorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Set once the invitation is accepted"/>
        <FIELD NAME="email" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Address the invitation was sent to"/>
        <FIELD NAME="role" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="admin, teaching or support"/>
        <FIELD NAME="status" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="invited" SEQUENCE="false" COMMENT="invited or active"/>
        <FIELD NAME="token" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="Invitation link secret, cleared once used"/>
        <FIELD NAME="invitedby" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timeaccepted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="creatorid" TYPE="foreign" FIELDS="creatorid" REFTABLE="local_oriskill_creators" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="token" UNIQUE="false" FIELDS="token"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oriskill_log" COMMENT="What was done in a trainer space, and by whom">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="creatorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Who did it, 0 for Oriskill itself (automatic)"/>
        <FIELD NAME="action" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="relateduserid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Learner or collaborator concerned"/>
        <FIELD NAME="details" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="creatorid" TYPE="foreign" FIELDS="creatorid" REFTABLE="local_oriskill_creators" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="creatortime" UNIQUE="false" FIELDS="creatorid, timecreated"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oriskill_orderforms" COMMENT="Order forms of a trainer: a sales page with offers, paid through the trainer's account">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="creatorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="slug" TYPE="char" LENGTH="60" NOTNULL="true" SEQUENCE="false" COMMENT="Address part, unique per trainer"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="headline" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="descriptionformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="buttonlabel" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="thankyou" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Message shown after payment"/>
        <FIELD NAME="termsrequired" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Buyer must accept the terms"/>
        <FIELD NAME="bumplabel" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Extra offered as a box to tick at the order step (order bump)"/>
        <FIELD NAME="bumptext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="bumpcourseids" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="bumpprice" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false"/>
        <FIELD NAME="upselllabel" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Offer shown after payment, paid with the saved card"/>
        <FIELD NAME="upselltext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="upsellcourseids" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="upsellprice" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="draft" SEQUENCE="false" COMMENT="draft or published"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="creatorid" TYPE="foreign" FIELDS="creatorid" REFTABLE="local_oriskill_creators" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="creatorslug" UNIQUE="true" FIELDS="creatorid, slug"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oriskill_formoffers" COMMENT="Offers of an order form: the courses opened and how they are paid">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="formid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="label" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="details" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="What the offer includes, one point per line"/>
        <FIELD NAME="courseids" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Comma-separated courses opened after payment"/>
        <FIELD NAME="price" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false" COMMENT="Paid at once"/>
        <FIELD NAME="instalcount" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0: no payment in instalments"/>
        <FIELD NAME="instaltotal" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false"/>
        <FIELD NAME="highlight" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="actags" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="ActiveCampaign tags added to buyers of this offer, comma-separated"/>
        <FIELD NAME="subprice" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false" COMMENT="Monthly subscription price, 0 when not offered"/>
        <FIELD NAME="instalfirst" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false" COMMENT="First instalment when it differs from the others (a deposit), 0 for equal instalments"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="formid" TYPE="foreign" FIELDS="formid" REFTABLE="local_oriskill_orderforms" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_oriskill_activecampaign" COMMENT="A trainer's ActiveCampaign account: buyers are added to it once paid">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="creatorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="apiurl" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="https://account.api-us1.com"/>
        <FIELD NAME="apikey" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Encrypted"/>
        <FIELD NAME="listid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="List buyers are subscribed to"/>
        <FIELD NAME="tags" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Tags added on every purchase, comma-separated"/>
        <FIELD NAME="coursetags" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Also tag with the name of each course bought"/>
        <FIELD NAME="unpaidtag" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="Tag added when an instalment is unpaid"/>
        <FIELD NAME="lastresult" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Outcome of the last call, shown to the trainer"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="creatorid" TYPE="foreign-unique" FIELDS="creatorid" REFTABLE="local_oriskill_creators" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_oriskill_coupons" COMMENT="Promo codes of a trainer, used on their order forms">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="creatorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="code" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="Uppercase"/>
        <FIELD NAME="type" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="percent" SEQUENCE="false" COMMENT="percent or amount"/>
        <FIELD NAME="value" TYPE="number" LENGTH="20" NOTNULL="true" DEFAULT="0" DECIMALS="2" SEQUENCE="false"/>
        <FIELD NAME="formid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Only this order form, null for all"/>
        <FIELD NAME="instalments" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Also valid when paying in instalments"/>
        <FIELD NAME="maxuses" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0: unlimited"/>
        <FIELD NAME="uses" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Paid orders that used it"/>
        <FIELD NAME="validfrom" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="validuntil" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0: no end"/>
        <FIELD NAME="active" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="creatorid" TYPE="foreign" FIELDS="creatorid" REFTABLE="local_oriskill_creators" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="creatorcode" UNIQUE="true" FIELDS="creatorid, code"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oriskill_webhooks" COMMENT="Addresses a trainer's events are posted to (Zapier, Make, own tools)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="creatorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="url" TYPE="char" LENGTH="1333" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="secret" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Signing secret, encrypted"/>
        <FIELD NAME="events" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Comma-separated events"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="lastresult" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="creatorid" TYPE="foreign" FIELDS="creatorid" REFTABLE="local_oriskill_creators" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_oriskill_formstats" COMMENT="Daily visits of the order forms and their order step, per offer">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="formid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="offerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 for the form page itself"/>
        <FIELD NAME="day" TYPE="int" LENGTH="8" NOTNULL="true" SEQUENCE="false" COMMENT="YYYYMMDD"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="view (form page) or checkout (order step)"/>
        <FIELD NAME="hits" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Visitors that day"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="formid" TYPE="foreign" FIELDS="formid" REFTABLE="local_oriskill_orderforms" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="formofferdaykind" UNIQUE="true" FIELDS="formid, offerid, day, kind"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oriskill_capturepages" COMMENT="Capture pages of a trainer: free courses in exchange for an e-mail address">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="creatorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="slug" TYPE="char" LENGTH="60" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="headline" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="descriptionformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="buttonlabel" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="courseids" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Free courses opened on sign-up"/>
        <FIELD NAME="accessdays" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0: unlimited access"/>
        <FIELD NAME="thankyou" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="redirectformid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Order form shown after sign-up"/>
        <FIELD NAME="actags" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="draft" SEQUENCE="false"/>
        <FIELD NAME="views" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Visitors (once a day each)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="creatorid" TYPE="foreign" FIELDS="creatorid" REFTABLE="local_oriskill_creators" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="creatorslug" UNIQUE="true" FIELDS="creatorid, slug"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oriskill_leads" COMMENT="People who signed up on a trainer's capture page">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pageid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="creatorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="email" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="firstname" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="consent" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Agreed to receive the trainer's e-mails"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="pageid" TYPE="foreign" FIELDS="pageid" REFTABLE="local_oriskill_capturepages" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="pageuser" UNIQUE="true" FIELDS="pageid, userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
