{{!
    @template local_oriskill/orderform

    Public order form of a trainer, in the trainer's brand: page texts and image, then the offers to order.

    Example context (json):
    {
        "displayname": "Studio Data", "logo": "", "initial": "S", "showcaseurl": "#",
        "style": {"primary": "#7c3aed", "onprimary": "#ffffff", "accent": "#fbbf24", "onaccent": "#111827",
                  "ink": "#7c3aed", "font": "Georgia, serif"},
        "title": "Formation Excel", "headline": "Devenez autonome en 6 semaines", "description": "<p>Texte</p>",
        "image": "", "cansell": true, "year": "2026", "links": [{"url": "#", "label": "Conditions générales"}],
        "offers": [{"label": "Essentiel", "details": ["Accès 1 an"], "courses": [{"name": "Excel"}],
                    "displayprice": "199,00 €", "url": "#", "buttonlabel": "Commander", "highlight": true,
                    "buttonstyle": "font-size: 1rem", "buttonalign": "center",
                    "others": [{"label": "ou 3 × 70,00 €", "url": "#"}] }]
    }
}}
<div class="oriskill-vitrine" style="--v-primary: {{style.primary}}; --v-on-primary: {{style.onprimary}}; --v-accent: {{style.accent}}; --v-on-accent: {{style.onaccent}}; --v-ink: {{style.ink}}; --v-font: {{style.font}};">
    <header class="oriskill-vitrine-bar">
        <a href="{{showcaseurl}}" class="oriskill-vitrine-brand">
            {{#logo}}<img src="{{logo}}" alt="" class="oriskill-vitrine-logo">{{/logo}}
            {{^logo}}<span class="oriskill-vitrine-initial" aria-hidden="true">{{initial}}</span>{{/logo}}
            <span>{{displayname}}</span>
        </a>
    </header>

    <section class="oriskill-vitrine-hero{{#image}} has-banner{{/image}}"
        {{#image}}style="background-image: url('{{image}}');"{{/image}}>
        <div class="oriskill-vitrine-hero-inner">
            <h1>{{title}}</h1>
            {{#headline}}<p class="oriskill-vitrine-tagline">{{headline}}</p>{{/headline}}
        </div>
    </section>

    <main class="oriskill-vitrine-main">
        {{#description}}
            <section class="oriskill-vitrine-about">{{{description}}}</section>
        {{/description}}

        <section id="oriskill-offers" aria-labelledby="oriskill-offers-heading">
            <h2 id="oriskill-offers-heading">{{#str}}orderform:choose, local_oriskill{{/str}}</h2>
            {{^cansell}}<p class="oriskill-vitrine-empty">{{#str}}error:formunavailable, local_oriskill{{/str}}</p>{{/cansell}}
            <div class="oriskill-offer-grid">
                {{#offers}}
                    <article class="oriskill-offer{{#highlight}} is-highlight{{/highlight}}">
                        {{#highlight}}<span class="oriskill-offer-flag">{{#str}}orderform:recommended, local_oriskill{{/str}}</span>{{/highlight}}
                        <h3>{{label}}</h3>
                        <p class="oriskill-offer-price">{{displayprice}}</p>
                        <ul>
                            {{#courses}}<li><strong>{{name}}</strong></li>{{/courses}}
                            {{#details}}<li>{{.}}</li>{{/details}}
                        </ul>
                        {{#cansell}}
                            <div class="oriskill-offer-cta is-{{buttonalign}}">
                                <a href="{{url}}" class="oriskill-vitrine-cta" style="{{buttonstyle}}">{{{buttonlabel}}}</a>
                            </div>
                            {{#others}}<a href="{{url}}" class="oriskill-offer-instalments">{{label}}</a>{{/others}}
                        {{/cansell}}
                    </article>
                {{/offers}}
            </div>
        </section>
    </main>

    <footer class="oriskill-vitrine-footer">
        <span>© {{year}} {{displayname}}</span>
        <nav aria-label="{{#str}}showcase:legal, local_oriskill{{/str}}">
            {{#links}}<a href="{{url}}">{{label}}</a>{{/links}}
        </nav>
    </footer>
</div>
