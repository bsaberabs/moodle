{{!
    @template local_oriskill/showcase

    Public trainer showcase, in the trainer's brand: their logo, name, colours, typeface and banner.

    Example context (json):
    {
        "displayname": "Studio Data",
        "tagline": "Formations pratiques en analyse de données",
        "bio": "<p>Présentation du formateur.</p>",
        "logo": "",
        "banner": "",
        "initial": "S",
        "style": {"primary": "#7c3aed", "onprimary": "#ffffff", "accent": "#fbbf24", "onaccent": "#111827", "ink": "#7c3aed",
                  "font": "Georgia, serif"},
        "accounturl": "#",
        "accountlabel": "Se connecter",
        "year": "2026",
        "links": [{"url": "#", "label": "Conditions générales"}],
        "hascourses": true,
        "courses": [{"name": "Excel pour l'analyse", "summary": "Résumé", "image": "", "price": "49,00 €",
                     "compareprice": "79,00 €", "url": "#"}]
    }
}}
<div class="oriskill-vitrine" style="--v-primary: {{style.primary}}; --v-on-primary: {{style.onprimary}}; --v-accent: {{style.accent}}; --v-on-accent: {{style.onaccent}}; --v-ink: {{style.ink}}; --v-font: {{style.font}};">
    <header class="oriskill-vitrine-bar">
        <a href="#top" class="oriskill-vitrine-brand">
            {{#logo}}<img src="{{logo}}" alt="" class="oriskill-vitrine-logo">{{/logo}}
            {{^logo}}<span class="oriskill-vitrine-initial" aria-hidden="true">{{initial}}</span>{{/logo}}
            <span>{{displayname}}</span>
        </a>
        <nav class="oriskill-vitrine-nav" aria-label="{{displayname}}">
            <a href="#oriskill-courses">{{#str}}creatorcourses, local_oriskill{{/str}}</a>
            <a href="{{accounturl}}" class="oriskill-vitrine-account">{{accountlabel}}</a>
        </nav>
    </header>

    <section id="top" class="oriskill-vitrine-hero{{#banner}} has-banner{{/banner}}"
        {{#banner}}style="background-image: url('{{banner}}');"{{/banner}}>
        <div class="oriskill-vitrine-hero-inner">
            <h1>{{displayname}}</h1>
            {{#tagline}}<p class="oriskill-vitrine-tagline">{{tagline}}</p>{{/tagline}}
            {{#hascourses}}<a href="#oriskill-courses" class="oriskill-vitrine-cta">{{#str}}showcase:seecourses, local_oriskill{{/str}}</a>{{/hascourses}}
        </div>
    </section>

    <main class="oriskill-vitrine-main">
        {{#bio}}
            <section class="oriskill-vitrine-about" aria-labelledby="oriskill-about-heading">
                <h2 id="oriskill-about-heading">{{#str}}aboutcreator, local_oriskill{{/str}}</h2>
                <div>{{{bio}}}</div>
            </section>
        {{/bio}}

        <section id="oriskill-courses" aria-labelledby="oriskill-courses-heading">
            <h2 id="oriskill-courses-heading">{{#str}}creatorcourses, local_oriskill{{/str}}</h2>
            {{#hascourses}}
                <div class="oriskill-vitrine-grid">
                    {{#courses}}
                        <article class="oriskill-vitrine-card">
                            {{#image}}<img src="{{image}}" alt="">{{/image}}
                            {{^image}}<div class="oriskill-vitrine-card-placeholder" aria-hidden="true"></div>{{/image}}
                            <div class="oriskill-vitrine-card-body">
                                <h3><a href="{{url}}">{{name}}</a></h3>
                                <p>{{summary}}</p>
                                <p class="oriskill-vitrine-price">
                                    <strong>{{price}}</strong>
                                    {{#compareprice}}<s>{{compareprice}}</s>{{/compareprice}}
                                </p>
                            </div>
                        </article>
                    {{/courses}}
                </div>
            {{/hascourses}}
            {{^hascourses}}
                <p class="oriskill-vitrine-empty">{{#str}}nocourses, local_oriskill{{/str}}</p>
            {{/hascourses}}
        </section>
    </main>

    <footer class="oriskill-vitrine-footer">
        <span>© {{year}} {{displayname}}</span>
        <nav aria-label="{{#str}}showcase:legal, local_oriskill{{/str}}">
            {{#links}}<a href="{{url}}">{{label}}</a>{{/links}}
        </nav>
    </footer>
</div>
