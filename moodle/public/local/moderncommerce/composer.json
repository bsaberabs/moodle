{
    "name": "local/moderncommerce",
    "description": "Open-source commerce platform for Moodle",
    "type": "moodle-local",
    "license": "GPL-3.0-or-later",
    "homepage": "https://moderncommerce.dev",
    "support": {
        "email": "support@agunfoninteractivity.com",
        "source": "https://github.com/adebareshowemimo/moodle-local_moderncommerce"
    },
    "require": {
        "php": ">=8.3",
        "paypal/paypal-server-sdk": "^1.1.0"
    },
    "autoload": {
        "psr-4": {
            "local_moderncommerce\\": "classes/"
        }
    },
    "config": {
        "vendor-dir": "vendor",
        "optimize-autoloader": true,
        "process-timeout": 900
    },
    "scripts": {
        "mc:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/git-check.ps1",
        "mc:check-fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/git-check.ps1 -Fast -SkipBuild -SkipPhpUnit -PhpcsReportOnly",
        "mc:css-audit": "node styles/tools/audit-css-usage.mjs",
        "mc:demo-audit": "php cli/demo_data.php --audit",
        "mc:demo-install": "php cli/demo_data.php --install-defaults",
        "mc:demo-reset": "php cli/demo_data.php --reset-empty --yes",
        "mc:demo-seed": "php cli/demo_data.php --seed",
        "mc:docs-check": "node scripts/check-docs.mjs",
        "mc:icon-audit": "node styles/tools/audit-bootstrap-icons.mjs",
        "mc:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/git-package.ps1 -Force",
        "mc:perf-report": "node scripts/performance-report.mjs",
        "mc:perf-smoke": "node scripts/performance-smoke.mjs",
        "mc:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/git-release.ps1 -ForcePackage",
        "mc:string-audit": "node scripts/check-string-audit.mjs",
        "mc:hooks": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-git-hooks.ps1"
    }
}
