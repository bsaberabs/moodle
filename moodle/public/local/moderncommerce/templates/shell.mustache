{{!
    @template local_moderncommerce/shell

    Admin console shell using the Modern Commerce admin layout system.
    Uses the local-moderncommerce-admin-* classes / --mc-admin-* tokens provided by this plugin.
    Dark slate sidebar,
    sticky header strip, content area, footer, and an off-canvas mobile drawer.

    Context variables (unchanged from the previous shell contract):
    * title         - Page title (shown in header strip)
    * subtitle      - Optional subtitle
    * actionshtml   - Optional action buttons HTML (trusted)
    * contenthtml   - Main page content HTML (trusted)
    * navigation    - Optional array of nav groups [{label, items[{url, icon, label, active, hasbadge, badge, badgevariant}]}]
    * hasnavigation - bool (use data-driven nav; else hardcoded fallback below)
    * nav.*active   - Legacy active flags used by the hardcoded fallback nav
    * plugins.*     - Optional plugin availability flags for the fallback nav
    * config.wwwroot - Moodle wwwroot
    * version       - Optional plugin version string (footer)


    @copyright  2025 Adebare Showemimo | adebareshowemimo@gmail.com | support@agunfoninteractivity.com
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="local-moderncommerce-admin-shell" id="local-moderncommerce-admin-shell">

    {{! ── Sidebar ── }}
    <aside class="local-moderncommerce-admin-sidebar"
           id="local-moderncommerce-admin-sidebar"
           role="navigation"
           aria-label="{{#str}}adminnavigation, local_moderncommerce{{/str}}">

        <div class="local-moderncommerce-admin-sidebar__header">
            <div class="local-moderncommerce-admin-sidebar__brand">
                <span class="local-moderncommerce-admin-sidebar__logo" aria-hidden="true">
                    <i class="bi bi-cart3"></i>
                </span>
                <span class="local-moderncommerce-admin-sidebar__title">{{#str}}pluginname, local_moderncommerce{{/str}}</span>
            </div>
