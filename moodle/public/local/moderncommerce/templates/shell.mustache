{{#js}}
require(['jquery'], function($) {
    'use strict';

    var $sidebar = $('#local-moderncommerce-admin-sidebar');
    var $toggleBtn = $('#local-moderncommerce-admin-sidebar-toggle');
    var $toggleIcon = $('#local-moderncommerce-admin-sidebar-toggle-icon');
    var $menuBtn = $('#local-moderncommerce-admin-menu-toggle');
    var $backdrop = $('#local-moderncommerce-admin-sidebar-backdrop');
    var mqMobile = window.matchMedia('(max-width: 768px)');
    var navGroupsStorageKey = 'local-moderncommerce-admin-nav-groups';

    function getPersistedNavGroups() {
        var raw = null;
        try {
            raw = localStorage.getItem(navGroupsStorageKey);
        } catch (e) {
            raw = null;
        }

        if (!raw) {
            return {};
        }

        try {
            return JSON.parse(raw) || {};
        } catch (e) {
            return {};
        }
    }

    function savePersistedNavGroups(groups) {
        try {
            localStorage.setItem(navGroupsStorageKey, JSON.stringify(groups));
        } catch (e) {
            // Persistence is progressive enhancement; the navigation still works without it.
        }
    }

    function setNavGroupExpanded($item, expanded, persist) {
        var $submenu = $item.children('.local-moderncommerce-admin-subnav');
        var $toggle = $item.children('.local-moderncommerce-admin-nav-item__row')
            .children('.local-moderncommerce-admin-nav-item__toggle');

        $item.toggleClass('local-moderncommerce-admin-nav-item--expanded', expanded);
        if (expanded) {
            $submenu.removeAttr('hidden');
        } else {
            $submenu.attr('hidden', 'hidden');
        }
        $toggle.attr('aria-expanded', expanded ? 'true' : 'false');

        if (!persist) {
            return;
        }

        var key = String($item.data('nav-group-key') || '');
        if (!key) {
            return;
        }

        var groups = getPersistedNavGroups();
        groups[key] = !!expanded;
        savePersistedNavGroups(groups);
    }

    var persistedNavGroups = getPersistedNavGroups();
    $sidebar.find('.local-moderncommerce-admin-nav-item--has-children').each(function() {
        var $item = $(this);
        var key = String($item.data('nav-group-key') || '');
        var hasActivePage = $item.hasClass('local-moderncommerce-admin-nav-item--active')
            || $item.hasClass('local-moderncommerce-admin-nav-item--ancestor-active')
            || $item.children('.local-moderncommerce-admin-subnav')
                .find('.local-moderncommerce-admin-subnav__item--active').length > 0;
        var expanded = $item.hasClass('local-moderncommerce-admin-nav-item--expanded');

        if (hasActivePage) {
            expanded = true;
        } else if (Object.prototype.hasOwnProperty.call(persistedNavGroups, key)) {
            expanded = persistedNavGroups[key] === true;
        }

        setNavGroupExpanded($item, expanded, false);
    });

    $sidebar.on('click', '.local-moderncommerce-admin-nav-item__toggle', function(e) {
        e.preventDefault();
        e.stopPropagation();

        var $item = $(this).closest('.local-moderncommerce-admin-nav-item--has-children');
        setNavGroupExpanded(
            $item,
            !$item.hasClass('local-moderncommerce-admin-nav-item--expanded'),
            true
        );
    });

    // ── Mobile off-canvas drawer ──
    function openMobileSidebar() {
        $sidebar.addClass('local-moderncommerce-admin-sidebar--open');
        $backdrop.addClass('local-moderncommerce-admin-sidebar-backdrop--visible');
        $menuBtn.attr('aria-expanded', 'true');
    }
    function closeMobileSidebar() {
        $sidebar.removeClass('local-moderncommerce-admin-sidebar--open');
        $backdrop.removeClass('local-moderncommerce-admin-sidebar-backdrop--visible');
        $menuBtn.attr('aria-expanded', 'false');
    }

    $menuBtn.on('click', function() {
        if (mqMobile.matches) {
            // Mobile: open/close the off-canvas drawer.
            if ($sidebar.hasClass('local-moderncommerce-admin-sidebar--open')) {
                closeMobileSidebar();
            } else {
                openMobileSidebar();
            }
        } else {
            // Desktop: collapse/expand the sidebar (reuse the chevron handler).
            $toggleBtn.trigger('click');
        }
    });
    $backdrop.on('click', closeMobileSidebar);
    $sidebar.on('click', '.local-moderncommerce-admin-nav-item__link, .local-moderncommerce-admin-subnav__link', function() {
        if (mqMobile.matches) {
            closeMobileSidebar();
        }
    });
    $(document).on('keydown', function(e) {
        if (e.key === 'Escape' && $sidebar.hasClass('local-moderncommerce-admin-sidebar--open')) {
            closeMobileSidebar();
            $menuBtn.trigger('focus');
        }
    });
    mqMobile.addEventListener('change', function(e) {
        if (!e.matches) {
            closeMobileSidebar();
        }
    });

    // ── Desktop collapse/expand (persisted) ──
    var collapsed = localStorage.getItem('local-moderncommerce-admin-sidebar-collapsed') === 'true';
    if (collapsed) {
        $sidebar.addClass('local-moderncommerce-admin-sidebar--collapsed');
        $toggleIcon.removeClass('bi-chevron-left').addClass('bi-chevron-right');
        $toggleBtn.attr('aria-expanded', 'false');
    }

    $toggleBtn.on('click', function() {
        if (mqMobile.matches) {
            closeMobileSidebar();
            return;
        }
        var isCollapsed = $sidebar.hasClass('local-moderncommerce-admin-sidebar--collapsed');
        if (isCollapsed) {
            $sidebar.removeClass('local-moderncommerce-admin-sidebar--collapsed');
            $toggleIcon.removeClass('bi-chevron-right').addClass('bi-chevron-left');
            $toggleBtn.attr('aria-expanded', 'true');
            localStorage.setItem('local-moderncommerce-admin-sidebar-collapsed', 'false');
        } else {
            $sidebar.addClass('local-moderncommerce-admin-sidebar--collapsed');
            $toggleIcon.removeClass('bi-chevron-left').addClass('bi-chevron-right');
            $toggleBtn.attr('aria-expanded', 'false');
            localStorage.setItem('local-moderncommerce-admin-sidebar-collapsed', 'true');
        }
    });
});

{{/js}}
