                <h4 class="local-moderncommerce-admin-nav-group__heading" aria-hidden="true">{{label}}</h4>
                <ul class="local-moderncommerce-admin-nav-group__list" role="list">
                    {{#items}}
                    <li class="local-moderncommerce-admin-nav-item {{#active}}local-moderncommerce-admin-nav-item--active{{/active}} {{#ancestoractive}}local-moderncommerce-admin-nav-item--ancestor-active{{/ancestoractive}} {{#haschildren}}local-moderncommerce-admin-nav-item--has-children{{/haschildren}} {{#expanded}}local-moderncommerce-admin-nav-item--expanded{{/expanded}}"
                        data-nav-group-key="{{key}}"
                        role="listitem">
                        <div class="local-moderncommerce-admin-nav-item__row">
                            <a href="{{url}}"
                               class="local-moderncommerce-admin-nav-item__link"
                               {{#current}}aria-current="page"{{/current}}
                               {{#newtab}}target="_blank" rel="noopener"{{/newtab}}
                               title="{{label}}">
                                <span class="local-moderncommerce-admin-nav-item__icon" aria-hidden="true">
                                    <i class="bi {{icon}}"></i>
                                </span>
                                <span class="local-moderncommerce-admin-nav-item__label">{{label}}</span>
                                {{#hasbadge}}
                                <span class="local-moderncommerce-admin-nav-item__badge {{#badgedanger}}local-moderncommerce-admin-nav-item__badge--danger{{/badgedanger}}"
                                      aria-label="{{badge}}">{{badge}}</span>
                                {{/hasbadge}}
                            </a>
                            {{#haschildren}}
                            <button type="button"
