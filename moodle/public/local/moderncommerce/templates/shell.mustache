                                    <span class="local-moderncommerce-admin-subnav__icon" aria-hidden="true">
                                        <i class="bi {{icon}}"></i>
                                    </span>
                                    <span class="local-moderncommerce-admin-subnav__label">{{label}}</span>
                                    {{#hasbadge}}
                                    <span class="local-moderncommerce-admin-nav-item__badge {{#badgedanger}}local-moderncommerce-admin-nav-item__badge--danger{{/badgedanger}}"
                                          aria-label="{{badge}}">{{badge}}</span>
                                    {{/hasbadge}}
                                </a>
                            </li>
                            {{/children}}
                        </ul>
                        {{/haschildren}}
                    </li>
                    {{/items}}
                </ul>
            </div>
            {{/navigation}}
            {{/hasnavigation}}

