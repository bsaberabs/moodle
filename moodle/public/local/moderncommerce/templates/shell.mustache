                    aria-expanded="true"
                    aria-controls="local-moderncommerce-admin-sidebar">
                <i class="bi bi-chevron-left" id="local-moderncommerce-admin-sidebar-toggle-icon" aria-hidden="true"></i>
            </button>
        </div>

        <nav class="local-moderncommerce-admin-sidebar__nav">
            {{#hasnavigation}}
            {{#navigation}}
