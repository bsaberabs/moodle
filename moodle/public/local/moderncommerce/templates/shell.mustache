                                <i class="bi bi-caret-right-fill local-moderncommerce-admin-nav-item__toggle-icon" aria-hidden="true"></i>
                            </button>
                            {{/haschildren}}
                        </div>
                        {{#haschildren}}
                        <ul class="local-moderncommerce-admin-subnav"
                            id="{{submenuid}}"
                            role="list"
                            {{^expanded}}hidden{{/expanded}}>
                            {{#children}}
                            <li class="local-moderncommerce-admin-subnav__item {{#active}}local-moderncommerce-admin-subnav__item--active{{/active}}"
                                role="listitem">
                                <a href="{{url}}"
                                   class="local-moderncommerce-admin-subnav__link"
                                   {{#current}}aria-current="page"{{/current}}
                                   {{#newtab}}target="_blank" rel="noopener"{{/newtab}}
