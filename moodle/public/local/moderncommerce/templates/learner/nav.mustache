{{!
    @template local_moderncommerce/learner/nav

    Learner account tab navigation partial.
    Horizontal tab-style links for dashboard, courses, orders, etc.

    Context variables:
    * navitems - Array of {url, label, icon, active}


    @copyright  2025 Adebare Showemimo | adebareshowemimo@gmail.com | support@agunfoninteractivity.com
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<nav class="mc-learner-nav-links" role="navigation"
     aria-label="{{#str}}learnernavigation, local_moderncommerce{{/str}}">
    {{#navitems}}
    <a href="{{url}}"
       class="mc-learner-nav-link {{#active}}active{{/active}}"
       {{#active}}aria-current="page"{{/active}}>
        <i class="bi {{icon}}" aria-hidden="true"></i>
        <span>{{label}}</span>
    </a>
    {{/navitems}}
</nav>
