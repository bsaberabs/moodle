{{!
    @template local_moderncommerce/redeem

    Single enrollment key redemption. Calm, direct form.
    Success and error states visible. Reduces user anxiety.

    Context variables:
    * showform     - bool
    * redeemurl    - Form action URL
    * sesskey      - Session key
    * orderid      - Order ID (if order-aware)
    * coursename   - Course name (if known)
    * hascourse    - bool
    * success      - bool
    * successurl   - URL to go to course after success
    * error        - Error message string
    * haserror     - bool
    * catalogurl   - Back to catalog URL


    @copyright  2025 Adebare Showemimo | adebareshowemimo@gmail.com | support@agunfoninteractivity.com
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="mc-redeem-page py-5">
    <div class="container">

        {{#success}}
        <div class="mc-redeem-card">
            <span class="mc-redeem-card__icon"><i class="bi bi-check-circle-fill text-success" aria-hidden="true"></i></span>
            <h1 class="mc-redeem-card__title">{{#str}}keyredeemed, local_moderncommerce{{/str}}</h1>
            <p class="mc-redeem-card__desc">{{#str}}enrollmentsuccess, local_moderncommerce{{/str}}</p>
            {{#successurl}}
            <a href="{{successurl}}" class="mc-button btn-mc-primary" data-mc-button="primary">
                <i class="bi bi-play-circle me-1" aria-hidden="true"></i>
                {{#str}}gotocourse, local_moderncommerce{{/str}}
            </a>
            {{/successurl}}
        </div>
        {{/success}}

        {{^success}}
        <div class="mc-redeem-card">
            <span class="mc-redeem-card__icon">
                <i class="bi bi-key" aria-hidden="true"></i>
            </span>
            <h1 class="mc-redeem-card__title">{{#str}}redeemkey, local_moderncommerce{{/str}}</h1>
            {{#hascourse}}
            <p class="mc-redeem-card__desc">{{coursename}}</p>
            {{/hascourse}}
            {{^hascourse}}
            <p class="mc-redeem-card__desc">{{#str}}enterkeydescription, local_moderncommerce{{/str}}</p>
            {{/hascourse}}

            {{#haserror}}
            <div class="alert alert-danger d-flex gap-2 align-items-center py-2 mb-3 w-100">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                {{error}}
            </div>
            {{/haserror}}

            {{#showform}}
            <form method="post" action="{{redeemurl}}" class="w-100">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                {{#orderid}}<input type="hidden" name="orderid" value="{{orderid}}">{{/orderid}}
                <div class="mb-3">
                    <label for="mc-keycode" class="form-label fw-semibold">
                        {{#str}}keycode, local_moderncommerce{{/str}}
                        <span class="mc-required" aria-hidden="true">*</span>
                    </label>
                    <input type="text"
                           class="form-control mc-key-input"
                           id="mc-keycode"
                           name="keycode"
                           placeholder="{{#str}}enterkey, local_moderncommerce{{/str}}"
                           autocomplete="off"
                           required>
                </div>
                <button type="submit" class="mc-button btn-mc-primary w-100 d-flex justify-content-center"
                        data-mc-button="primary" data-mc-loading-submit data-mc-loading-label="{{#str}}loading, local_moderncommerce{{/str}}">
                    <i class="bi bi-key me-1" aria-hidden="true"></i>
                    {{#str}}redeemkey, local_moderncommerce{{/str}}
                </button>
            </form>
            {{/showform}}

            <div class="mt-4 pt-3 border-top w-100 d-flex justify-content-center">
                <a href="{{catalogurl}}" class="mc-button btn-sm mc-btn-soft" data-mc-button="soft" data-mc-button-size="sm">
                    {{#str}}browsecatalog, local_moderncommerce{{/str}}
                </a>
            </div>
        </div>
        {{/success}}

    </div>
</div>

<script>
(function() {
    document.addEventListener('submit', function(event) {
        var button = event.target.querySelector('[data-mc-loading-submit]');
        if (!button) {
            return;
        }
        button.setAttribute('aria-busy', 'true');
        button.setAttribute('data-mc-button-state', 'loading');
        button.disabled = true;
        button.textContent = button.getAttribute('data-mc-loading-label') || 'Loading...';
    });
})();
</script>
