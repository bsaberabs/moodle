{{!
    @template local_moderncommerce/bundle_course_card

    Course card for bundle details page

    @copyright  2025 Adebare Showemimo | adebareshowemimo@gmail.com | support@agunfoninteractivity.com
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "courseurl": "/local/moderncommerce/course_details.php?id=123",
        "courseimageurl": "/path/to/image.jpg",
        "coursename": "Angular - The Complete Guide",
        "isfree": false,
        "categoryname": "Development",
        "summary": "Explore our curated collection of courses designed to enhance your web design and development skills.",
        "duration": "21h 58m",
        "activitycount": 52,
        "level": "Intermediate",
        "rating": "4.5",
        "haswishlist": true
    }
}}
<div class="card mb-3 border-light mc-bundle-course-card">
    <div class="card-body p-3">
        <div class="row align-items-center">

            {{! Left side - Course image }}
            <div class="col-md-5 position-relative">
                <div class="position-relative">
                    {{#isenrolled}}
                    <span class="badge bg-primary mc-bundle-course-card__badge">{{#str}}alreadyenrolled, local_moderncommerce{{/str}}</span>
                    {{/isenrolled}}
                    {{^isenrolled}}
                    {{#isfree}}
                    <span class="badge bg-success mc-bundle-course-card__badge">{{#str}}free, local_moderncommerce{{/str}}</span>
                    {{/isfree}}
                    {{/isenrolled}}
                    <img src="{{{courseimageurl}}}"
                         class="img-fluid rounded mc-bundle-course-card__image"
                         alt="{{coursename}}">
                </div>
            </div>

            {{! Right side - Course details }}
            <div class="col-md-7">

                {{! Category badge and rating }}
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        {{#categoryname}}
                        <span class="badge bg-primary">{{{categoryname}}}</span>
                        {{/categoryname}}
                    </div>
                    <div>
                        {{#rating}}
                        {{{rating}}}
                        {{/rating}}
                    </div>
                </div>

                {{! Course title }}
                <h5 class="mb-2">
                    <a href="{{{courseurl}}}" class="text-dark">{{{coursename}}}</a>
                </h5>

                {{! Description }}
                {{#summary}}
                <p class="text-muted small mb-3">{{{summary}}}</p>
                {{/summary}}

                {{! Price display }}
                {{^isenrolled}}
                {{^isfree}}
                <div class="mb-3">
                    {{#hassale}}
                    <span class="h5 text-success fw-bold mb-0">{{{saleprice}}}</span>
                    <del class="text-muted ms-2">{{{regularprice}}}</del>
                    {{/hassale}}
                    {{^hassale}}
                    <span class="h5 text-primary fw-bold mb-0">{{{regularprice}}}</span>
                    {{/hassale}}
                </div>
                {{/isfree}}
                {{/isenrolled}}

                {{! Meta information and button }}
                <div class="d-flex justify-content-between align-items-center text-muted small">
                    <div class="d-flex align-items-center">
                        {{#duration}}
                        <span class="me-3">
                            <i class="bi bi-clock"></i> {{{duration}}}
                        </span>
                        {{/duration}}

                        {{#activitycount}}
                        <span class="me-3">
                            <i class="bi bi-list-ul"></i> {{{activitycount}}} {{#str}}lectures, local_moderncommerce{{/str}}
                        </span>
                        {{/activitycount}}

                        {{#level}}
                        <span class="me-3">
                            <i class="bi bi-bar-chart"></i> {{{level}}}
                        </span>
                        {{/level}}
                    </div>

                    {{! View/Resume button }}
                    {{#isenrolled}}
                    <a href="{{{courseviewurl}}}" class="mc-button btn-mc-primary btn-sm" data-mc-button="primary" data-mc-button-size="sm">
                        <i class="bi bi-play-fill"></i> {{#str}}courseresume, local_moderncommerce{{/str}}
                    </a>
                    {{/isenrolled}}
                    {{^isenrolled}}
                    <a href="{{{courseurl}}}" class="mc-button btn-mc-dark btn-sm" data-mc-button="dark" data-mc-button-size="sm">{{#str}}viewdetails, local_moderncommerce{{/str}}</a>
                    {{/isenrolled}}
                </div>

            </div>

        </div>
    </div>
</div>
