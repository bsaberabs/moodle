{{!
    @template local_moderncommerce/admin/course_keys

    Course-specific enrollment key management. Generate form + keys table.

    Context variables:
    * course       - {id, name}
    * keys         - Array: {id, keycode, keytype, maxuses, usedcount, expiry, status, statusclass, copyurl, deactivateurl, deleteurl}
    * haskeys      - bool
    * generateform - {action, sesskey, typeoptions[], maxuses, validdays, quantity}
    * backurl      - URL to keys overview
    * pagination   - Pagination HTML (trusted)


    @copyright  2025 Adebare Showemimo | adebareshowemimo@gmail.com | support@agunfoninteractivity.com
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div id="mc-course-keys-container" data-region="course-keys">

    {{! Generate form }}
    <div class="mc-form-section mb-4">
        <div class="mc-form-section__header">
            <h2 class="mc-form-section__title">
                <i class="bi bi-lightning me-2" aria-hidden="true"></i>
                {{#str}}generatekeys, local_moderncommerce{{/str}} &mdash; {{course.name}}
            </h2>
        </div>
        <div class="mc-form-section__body">
            <form method="post" action="{{generateform.action}}" class="row g-3 align-items-end">
                <input type="hidden" name="sesskey" value="{{generateform.sesskey}}">
                <input type="hidden" name="courseid" value="{{course.id}}">
                <div class="col-sm-3">
                    <label for="mc-ck-qty" class="mc-field-label">{{#str}}numberofkeys, local_moderncommerce{{/str}}</label>
                    <input type="number" class="form-control form-control-sm" id="mc-ck-qty"
                           name="quantity" value="{{generateform.quantity}}" min="1" max="100">
                    <div class="mc-field-help">{{#str}}quantityhelp, local_moderncommerce{{/str}}</div>
                </div>
                <div class="col-sm-3">
                    <label for="mc-ck-type" class="mc-field-label">{{#str}}keytype, local_moderncommerce{{/str}}</label>
                    <select class="form-select form-select-sm" id="mc-ck-type" name="keytype">
                        {{#generateform.typeoptions}}
                        <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
                        {{/generateform.typeoptions}}
                    </select>
                    <div class="mc-field-help">{{#str}}keytypehelp, local_moderncommerce{{/str}}</div>
                </div>
                <div class="col-sm-3">
                    <label for="mc-ck-maxuses" class="mc-field-label">{{#str}}maxusesperkey, local_moderncommerce{{/str}}</label>
                    <input type="number" class="form-control form-control-sm" id="mc-ck-maxuses"
                           name="maxuses" value="{{generateform.maxuses}}" min="1">
                    <div class="mc-field-help">{{#str}}maxuseshelp, local_moderncommerce{{/str}}</div>
                </div>
                <div class="col-sm-3">
                    <label for="mc-ck-validdays" class="mc-field-label">{{#str}}expirydays, local_moderncommerce{{/str}}</label>
                    <input type="number" class="form-control form-control-sm" id="mc-ck-validdays"
                           name="validdays" value="{{generateform.validdays}}" min="0">
                    <div class="mc-field-help">{{#str}}zerofornoexpiry, local_moderncommerce{{/str}}</div>
                </div>
                <div class="col-12">
                    <button type="submit" class="mc-button btn-sm btn-mc-primary" data-mc-button="primary" data-mc-button-size="sm"
                            data-mc-loading-submit data-mc-loading-label="{{#str}}loading, local_moderncommerce{{/str}}">
                        <i class="bi bi-lightning me-1" aria-hidden="true"></i>
                        {{#str}}generatekeys, local_moderncommerce{{/str}}
                    </button>
                </div>
            </form>
        </div>
    </div>

    {{! Keys table }}
    {{#haskeys}}
    <div class="mc-table-wrapper">
        <table class="table mc-table mb-0" aria-label="{{#str}}enrollmentkeys, local_moderncommerce{{/str}}">
            <thead>
                <tr>
                    <th scope="col">{{#str}}keycode, local_moderncommerce{{/str}}</th>
                    <th scope="col">{{#str}}keytype, local_moderncommerce{{/str}}</th>
                    <th scope="col" class="text-center">{{#str}}uses, local_moderncommerce{{/str}}</th>
                    <th scope="col">{{#str}}expiry, local_moderncommerce{{/str}}</th>
                    <th scope="col">{{#str}}keystatus, local_moderncommerce{{/str}}</th>
                    <th scope="col" class="text-end pe-3">{{#str}}actions, local_moderncommerce{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#keys}}
                <tr>
                    <td class="mc-key-code">{{keycode}}</td>
                    <td class="mc-cell-muted">{{keytype}}</td>
                    <td class="text-center">
                        <span class="fw-semibold">{{usedcount}}</span>
                        {{#maxuses}}/{{maxuses}}{{/maxuses}}
                    </td>
                    <td class="mc-cell-muted mc-nowrap">
                        {{#expiry}}{{expiry}}{{/expiry}}{{^expiry}}{{#str}}never, local_moderncommerce{{/str}}{{/expiry}}
                    </td>
                    <td><span class="mc-badge mc-badge--{{statusclass}}">{{status}}</span></td>
                    <td class="text-end pe-3">
                        <div class="d-inline-flex gap-1">
                            {{#copyurl}}
                            <a href="{{copyurl}}"
                               class="mc-button btn-sm mc-btn-soft"
                               title="{{#str}}copyurl, local_moderncommerce{{/str}}"
                               aria-label="{{#str}}copyurl, local_moderncommerce{{/str}} {{keycode}}" data-mc-button="soft" data-mc-button-size="sm">
                                <i class="bi bi-clipboard" aria-hidden="true"></i>
                            </a>
                            {{/copyurl}}
                            {{#deactivateurl}}
                            <a href="{{deactivateurl}}"
                               class="mc-button btn-sm btn-mc-warning"
                               title="{{#str}}deactivate, local_moderncommerce{{/str}}"
                               aria-label="{{#str}}deactivate, local_moderncommerce{{/str}} {{keycode}}" data-mc-button="warning" data-mc-button-size="sm">
                                <i class="bi bi-pause-circle" aria-hidden="true"></i>
                            </a>
                            {{/deactivateurl}}
                            <a href="{{deleteurl}}"
                               class="mc-button btn-sm btn-mc-danger"
                               title="{{#str}}delete, local_moderncommerce{{/str}}"
                               aria-label="{{#str}}delete, local_moderncommerce{{/str}} {{keycode}}"
                               data-confirm="{{#str}}confirmdeletekey, local_moderncommerce{{/str}}" data-mc-button="danger" data-mc-button-size="sm">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                {{/keys}}
            </tbody>
        </table>
    </div>
    {{#pagination}}{{{pagination}}}{{/pagination}}
    {{/haskeys}}

    {{^haskeys}}
    <div class="mc-empty">
        <span class="mc-empty__icon"><i class="bi bi-key" aria-hidden="true"></i></span>
        <p class="mc-empty__title">{{#str}}noenrollmentkeys, local_moderncommerce{{/str}}</p>
    </div>
    {{/haskeys}}

</div>

<script>
(function() {
    document.addEventListener('submit', function(event) {
        var button = event.target.querySelector('[data-mc-loading-submit]');
        if (!button) {
            return;
        }
        button.setAttribute('aria-busy', 'true');
        button.setAttribute('data-mc-button-state', 'loading');
        button.disabled = true;
        button.textContent = button.getAttribute('data-mc-loading-label') || 'Loading...';
    });
})();
</script>
