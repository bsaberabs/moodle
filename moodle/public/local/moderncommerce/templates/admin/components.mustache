{{!
    @template local_moderncommerce/admin/components

    Component testing ground for Modern Commerce UI adoption.


    @copyright  2025 Adebare Showemimo | adebareshowemimo@gmail.com | support@agunfoninteractivity.com
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="mc-component-upgrades{{#usecomponenttypography}} mc-component-upgrades--typography{{/usecomponenttypography}}">
    <section class="mc-stat-strip" aria-labelledby="mc-stat-strip-title">
        <h5 id="mc-stat-strip-title" class="sr-only">Metric tile component</h5>
        <article class="mc-stat-tile mc-stat-tile--primary">
            <i class="bi bi-database mc-stat-tile__icon" aria-hidden="true"></i>
            <div class="mc-stat-tile__body">
                <span class="mc-stat-tile__label">Earnings</span>
                <strong class="mc-stat-tile__value">6659</strong>
            </div>
            <i class="bi bi-database-fill mc-stat-tile__watermark" aria-hidden="true"></i>
        </article>
        <article class="mc-stat-tile mc-stat-tile--muted">
            <i class="bi bi-bag mc-stat-tile__icon" aria-hidden="true"></i>
            <div class="mc-stat-tile__body">
                <span class="mc-stat-tile__label">Products</span>
                <strong class="mc-stat-tile__value">9856</strong>
            </div>
            <i class="bi bi-bag-fill mc-stat-tile__watermark" aria-hidden="true"></i>
        </article>
        <article class="mc-stat-tile mc-stat-tile--primary">
            <i class="bi bi-chat mc-stat-tile__icon" aria-hidden="true"></i>
            <div class="mc-stat-tile__body">
                <span class="mc-stat-tile__label">Messages</span>
                <strong class="mc-stat-tile__value">893</strong>
            </div>
            <i class="bi bi-chat mc-stat-tile__watermark" aria-hidden="true"></i>
        </article>
        <article class="mc-stat-tile mc-stat-tile--primary">
            <i class="bi bi-person-plus mc-stat-tile__icon" aria-hidden="true"></i>
            <div class="mc-stat-tile__body">
                <span class="mc-stat-tile__label">New Users</span>
                <strong class="mc-stat-tile__value">4531</strong>
            </div>
            <i class="bi bi-person-plus-fill mc-stat-tile__watermark" aria-hidden="true"></i>
        </article>
    </section>

    <section class="mc-button-system mc-typography-component" aria-labelledby="mc-toast-system-title">
        <div class="mc-typography-hero">
            <span class="mc-typography-eyebrow">Component 00</span>
            <h2 id="mc-toast-system-title" class="mc-typography-display">Notifications</h2>
            <p class="mc-typography-lead">Modern Commerce toast notifications use the shared toast component and the admin-configured screen position.</p>
        </div>

        <div class="mc-button-system__grid">
            <section class="mc-typography-card">
                <div class="mc-typography-card__header">
                    <h5>Toast Preview</h5>
                    <span>Static component markup</span>
                </div>
                <div class="mc-typography-card__body">
                    {{#toastpreview}}
                        {{> local_moderncommerce/components/toast }}
                    {{/toastpreview}}
                </div>
            </section>

            <section class="mc-typography-card">
                <div class="mc-typography-card__header">
                    <h5>Live Trigger</h5>
                    <span>Runtime floating toast</span>
                </div>
                <div class="mc-typography-card__body">
                    <div class="mc-button-system__row">
                        <button type="button" class="mc-button" data-mc-button="primary" id="mc-components-toast-trigger"
                                aria-describedby="mc-components-toast-status">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                            <span>Show toast</span>
                        </button>
                        <span class="mc-type-caption" id="mc-components-toast-status" aria-live="polite"></span>
                    </div>
                </div>
            </section>
        </div>
    </section>

    <section class="mc-button-system mc-typography-component" aria-labelledby="mc-button-system-title">
        <div class="mc-typography-hero">
            <span class="mc-typography-eyebrow">Component 01</span>
            <h2 id="mc-button-system-title" class="mc-typography-display">Buttons</h2>
            <p class="mc-typography-lead">Modern Commerce buttons use the <code>mc-button</code> primitive, design-system tokens, and a <code>data-mc-button</code> variant attribute.</p>
        </div>

        <div class="mc-button-system__panel">
            <div class="mc-button-system__toolbar" aria-label="Button variants">
                <button type="button" class="mc-button mc-button--primary" data-mc-button="primary">Primary</button>
                <button type="button" class="mc-button mc-button--secondary" data-mc-button="secondary">Secondary</button>
                <button type="button" class="mc-button mc-button--success" data-mc-button="success">Success</button>
                <button type="button" class="mc-button mc-button--danger" data-mc-button="danger">Danger</button>
                <button type="button" class="mc-button mc-button--warning" data-mc-button="warning">Warning</button>
                <button type="button" class="mc-button mc-button--info" data-mc-button="info">Info</button>
                <button type="button" class="mc-button mc-button--light" data-mc-button="light">Light</button>
                <button type="button" class="mc-button mc-button--dark" data-mc-button="dark">Dark</button>
            </div>
        </div>

        <div class="mc-button-system__grid">
            <section class="mc-typography-card">
                <div class="mc-typography-card__header">
                    <h5>States</h5>
                    <span>Normal, hover, active, disabled, loading</span>
                </div>
                <div class="mc-typography-card__body">
                    <div class="mc-button-system__row">
                        <button type="button" class="mc-button" data-mc-button="primary">Normal</button>
                        <button type="button" class="mc-button" data-mc-button="primary" data-mc-button-state="hover">Hover</button>
                        <button type="button" class="mc-button is-active" data-mc-button="primary" aria-pressed="true">Active</button>
                        <button type="button" class="mc-button" data-mc-button="primary" disabled>Disabled</button>
                        <button type="button" class="mc-button" data-mc-button="primary" data-mc-button-state="loading" aria-busy="true">Saving...</button>
                    </div>
                </div>
            </section>

            <section class="mc-typography-card">
                <div class="mc-typography-card__header">
                    <h5>Sizes</h5>
                    <span>Small, default, large, icon</span>
                </div>
                <div class="mc-typography-card__body">
                    <div class="mc-button-system__row">
                        <button type="button" class="mc-button" data-mc-button="secondary" data-mc-button-size="sm">Small</button>
                        <button type="button" class="mc-button" data-mc-button="secondary">Default</button>
                        <button type="button" class="mc-button" data-mc-button="secondary" data-mc-button-size="lg">Large</button>
                        <button type="button" class="mc-button" data-mc-button="secondary" data-mc-button-size="icon" aria-label="Settings">
                            <i class="bi bi-gear" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </section>

            <section class="mc-typography-card">
                <div class="mc-typography-card__header">
                    <h5>Links</h5>
                    <span>Anchors can use the same primitive</span>
                </div>
                <div class="mc-typography-card__body">
                    <div class="mc-button-system__row">
                        <a href="#" class="mc-button" data-mc-button="primary">View course</a>
                        <a href="#" class="mc-button" data-mc-button="soft">Soft link</a>
                        <a href="#" class="mc-button" data-mc-button="ghost">Ghost link</a>
                    </div>
                </div>
            </section>
        </div>
    </section>

    <section class="mc-component-section mc-typography-component" aria-labelledby="mc-feedback-system-title">
        <div class="mc-typography-hero">
            <span class="mc-typography-eyebrow">Component 02</span>
            <h2 id="mc-feedback-system-title" class="mc-typography-display">Status and Feedback</h2>
            <p class="mc-typography-lead">Inline feedback, semantic badges, empty states, loading, prices, and progress indicators share the same status palette and tokenized spacing.</p>
        </div>

        <div class="mc-typography-grid mc-typography-grid--three">
            <section class="mc-typography-card">
                <div class="mc-typography-card__header">
                    <h5>Alerts</h5>
                    <span>Persistent in-page feedback</span>
                </div>
                <div class="mc-typography-card__body">
                    <div class="mc-component-demo-stack">
                        {{#alertpreviews}}
                            {{> local_moderncommerce/components/alert }}
                        {{/alertpreviews}}
                    </div>
                </div>
            </section>

            <section class="mc-typography-card">
                <div class="mc-typography-card__header">
                    <h5>Badge System</h5>
                    <span>Brand, status, and tint levels</span>
                </div>
                <div class="mc-typography-card__body">
                    <div class="mc-component-demo-stack">
                        <div class="mc-component-badge-row" aria-label="Brand badge variants">
                            {{#brandbadges}}
                                {{> local_moderncommerce/components/badge }}
                            {{/brandbadges}}
                        </div>
                        <div class="mc-component-badge-row" aria-label="Status badge variants">
                            {{#statusbadges}}
                                {{> local_moderncommerce/components/badge }}
                            {{/statusbadges}}
                        </div>
                        <div class="mc-component-badge-row" aria-label="Badge tint levels">
                            {{#tintbadges}}
                                {{> local_moderncommerce/components/badge }}
                            {{/tintbadges}}
                        </div>
                        <div class="mc-component-progress-group">
                            <div class="mc-component-progress-row">
                                <span>Course completion</span>
                                <strong>68%</strong>
                            </div>
                            <div class="mc-progress-bar-wrap" role="progressbar" aria-label="Course completion" aria-valuenow="68" aria-valuemin="0" aria-valuemax="100">
                                <div class="mc-progress-bar-fill mc-component-progress-fill--68"></div>
                            </div>
                        </div>
                        <div class="mc-component-price-row" aria-label="Price display variants">
                            {{#pricepreviews}}
                                {{> local_moderncommerce/components/price_display }}
                            {{/pricepreviews}}
                        </div>
                    </div>
                </div>
            </section>

            <section class="mc-typography-card">
                <div class="mc-typography-card__header">
                    <h5>Empty and Loading</h5>
                    <span>Quiet states for async admin screens</span>
                </div>
                <div class="mc-typography-card__body">
                    <div class="mc-component-demo-stack">
                        {{#emptystate}}
                            {{> local_moderncommerce/components/empty_state }}
                        {{/emptystate}}
                        {{#loadingpreview}}
                            {{> local_moderncommerce/components/loading_spinner }}
                        {{/loadingpreview}}
                    </div>
                </div>
            </section>
        </div>
    </section>

    <section class="mc-component-section mc-typography-component" aria-labelledby="mc-form-system-title">
        <div class="mc-typography-hero">
            <span class="mc-typography-eyebrow">Component 03</span>
            <h2 id="mc-form-system-title" class="mc-typography-display">Forms and Selection</h2>
            <p class="mc-typography-lead">Admin form controls keep visible labels, compact field spacing, and familiar controls for binary and grouped choices.</p>
        </div>

        <div class="mc-typography-grid">
            <section class="mc-typography-card">
                <div class="mc-typography-card__header">
                    <h5>Field Set</h5>
                    <span>Inputs, selects, text areas, and helper text</span>
                </div>
                <div class="mc-typography-card__body">
                    <form class="mc-component-form" action="#" method="get" aria-label="Course product form demo">
                        <div class="mc-component-field-grid">
                            <label class="mc-component-field" for="mc-component-course-name">
                                <span class="mc-field-label">Course title</span>
                                <input class="mc-form-control" id="mc-component-course-name" type="text" value="Advanced Sales Strategy">
                            </label>
                            <label class="mc-component-field" for="mc-component-course-type">
                                <span class="mc-field-label">Product type</span>
                                <select class="mc-select" id="mc-component-course-type">
                                    <option>Single course</option>
                                    <option>Bundle</option>
                                    <option>Subscription plan</option>
                                </select>
                            </label>
                            <label class="mc-component-field" for="mc-component-course-price">
                                <span class="mc-field-label">Base price</span>
                                <input class="mc-form-control" id="mc-component-course-price" type="text" value="$129.00" inputmode="decimal">
                                <span class="mc-field-help">Use the configured commerce currency symbol.</span>
                            </label>
                            <label class="mc-component-field" for="mc-component-course-status">
                                <span class="mc-field-label">Status</span>
                                <select class="mc-select" id="mc-component-course-status">
                                    <option>Published</option>
                                    <option>Draft</option>
                                    <option>Archived</option>
                                </select>
                            </label>
                            <label class="mc-component-field mc-component-field--wide" for="mc-component-course-notes">
                                <span class="mc-field-label">Admin note</span>
                                <textarea class="mc-textarea" id="mc-component-course-notes" rows="3">Pricing change approved for the June promotion.</textarea>
                            </label>
                        </div>
                    </form>
                </div>
            </section>

            <section class="mc-typography-card">
                <div class="mc-typography-card__header">
                    <h5>Choices</h5>
                    <span>Checkboxes, radio buttons, and switches</span>
                </div>
                <div class="mc-typography-card__body">
                    <div class="mc-component-choice-stack">
                        <label class="mc-switch">
                            <input type="checkbox" checked>
                            <span class="mc-switch__track" aria-hidden="true"></span>
                            <span class="mc-switch__thumb" aria-hidden="true"></span>
                            <span class="mc-switch__label">Visible in catalog</span>
                        </label>
                        <label class="mc-checkbox">
                            <input type="checkbox" checked>
                            <span>Send purchase confirmation email</span>
                        </label>
                        <label class="mc-checkbox">
                            <input type="checkbox">
                            <span>Require manual enrolment approval</span>
                        </label>
                        <div class="mc-component-radio-group" role="radiogroup" aria-label="Checkout recovery timing">
                            <label class="mc-radio">
                                <input type="radio" name="mc-component-recovery" checked>
                                <span>After 1 hour</span>
                            </label>
                            <label class="mc-radio">
                                <input type="radio" name="mc-component-recovery">
                                <span>After 24 hours</span>
                            </label>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </section>

    <section class="mc-component-section mc-typography-component" aria-labelledby="mc-overlay-system-title">
        <div class="mc-typography-hero">
            <span class="mc-typography-eyebrow">Component 04</span>
            <h2 id="mc-overlay-system-title" class="mc-typography-display">Overlays and Actions</h2>
            <p class="mc-typography-lead">Dialogs and drawers reserve focused workflows for confirmation, edits, and setup without adding page-specific overlay styles.</p>
        </div>

        <div class="mc-typography-grid">
            <section class="mc-typography-card">
                <div class="mc-typography-card__header">
                    <h5>Confirmation Dialog</h5>
                    <span>Live modal using the shared modal shell</span>
                </div>
                <div class="mc-typography-card__body">
                    <div class="mc-component-demo-stack">
                        <button type="button" class="mc-button" data-mc-button="danger" id="mc-components-modal-trigger"
                                aria-haspopup="dialog" aria-controls="mc-components-modal">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                            <span>Open delete dialog</span>
                        </button>
                        <div class="mc-component-modal-preview" aria-hidden="true">
                            <div class="mc-component-modal-preview__header"></div>
                            <div class="mc-component-modal-preview__body">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                            <div class="mc-component-modal-preview__footer"></div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="mc-typography-card">
                <div class="mc-typography-card__header">
                    <h5>Drawer Anatomy</h5>
                    <span>Side panel structure used by admin editors</span>
                </div>
                <div class="mc-typography-card__body">
                    <div class="mc-component-demo-stack">
                        <button type="button" class="mc-button" data-mc-button="primary" id="mc-components-drawer-trigger"
                                aria-haspopup="dialog" aria-controls="mc-components-drawer" aria-expanded="false">
                            <i class="bi bi-layout-sidebar-inset-reverse" aria-hidden="true"></i>
                            <span>Open drawer</span>
                        </button>
                        <div class="mc-component-drawer-preview" aria-hidden="true">
                            <div class="mc-component-drawer-preview__header">
                                <span></span>
                                <i class="bi bi-x-lg"></i>
                            </div>
                            <div class="mc-component-drawer-preview__body">
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                            <div class="mc-component-drawer-preview__footer">
                                <span></span>
                                <span></span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="mc-modal-backdrop" id="mc-components-modal" hidden>
            <section class="mc-modal mc-modal--sm" role="dialog" aria-modal="true" aria-labelledby="mc-components-modal-title">
                <div class="mc-modal__header">
                    <h2 class="mc-modal__title" id="mc-components-modal-title">Archive course?</h2>
                    <button type="button" class="mc-modal__close" data-mc-demo-modal-close aria-label="Close dialog">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="mc-modal__body">
                    <div class="mc-modal__confirm">
                        <span class="mc-modal__icon mc-modal__icon--danger" aria-hidden="true">
                            <i class="bi bi-archive"></i>
                        </span>
                        <p class="mc-modal__message">This keeps learner records intact, but removes the course from new purchases.</p>
                    </div>
                </div>
                <div class="mc-modal__footer">
                    <button type="button" class="mc-button mc-btn-soft" data-mc-button="soft" data-mc-demo-modal-close>Cancel</button>
                    <button type="button" class="mc-button" data-mc-button="danger" data-mc-demo-modal-close>Archive course</button>
                </div>
            </section>
        </div>

        <div id="mc-components-drawer" hidden>
            <div class="mc-drawer-backdrop" data-mc-demo-drawer-close aria-hidden="true"></div>
            <aside class="mc-drawer mc-drawer--open" role="dialog" aria-modal="true" aria-labelledby="mc-components-drawer-title">
                <div class="mc-drawer__header">
                    <div>
                        <h2 class="mc-drawer__title" id="mc-components-drawer-title">Edit subscription plan</h2>
                        <div class="mc-drawer__subtitle">Shared <code>McDrawer</code> overlay shell</div>
                    </div>
                    <button type="button" class="mc-button mc-drawer__close" data-mc-demo-drawer-close aria-label="Close drawer">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="mc-drawer__body">
                    <form class="mc-component-form" action="#" method="get" aria-label="Drawer form demo">
                        <div class="mc-form-section">
                            <div class="mc-form-section__header">
                                <h4 class="mc-form-section__title">Plan details</h4>
                            </div>
                            <div class="mc-form-section__body">
                                <div class="mc-product-form__grid">
                                    <label class="mc-product-form__wide" for="mc-component-drawer-plan-name">
                                        <span>Plan name</span>
                                        <input class="mc-form-control" id="mc-component-drawer-plan-name" type="text" value="Professional membership">
                                    </label>
                                    <label for="mc-component-drawer-cycle">
                                        <span>Billing cycle</span>
                                        <select class="mc-select" id="mc-component-drawer-cycle">
                                            <option>Monthly</option>
                                            <option selected>Yearly</option>
                                        </select>
                                    </label>
                                    <label for="mc-component-drawer-price">
                                        <span>Price</span>
                                        <input class="mc-form-control" id="mc-component-drawer-price" type="number" min="0" step="0.01" value="199.00">
                                    </label>
                                    <label class="mc-product-form__wide" for="mc-component-drawer-description">
                                        <span>Description</span>
                                        <textarea class="mc-textarea" id="mc-component-drawer-description" rows="3">Annual access to all current business courses and certificates.</textarea>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="mc-drawer__footer">
                    <button type="button" class="mc-button" data-mc-button="primary" data-mc-demo-drawer-close>Save plan</button>
                    <button type="button" class="mc-button" data-mc-button="secondary" data-mc-demo-drawer-close>Cancel</button>
                </div>
            </aside>
        </div>
    </section>

    <section class="mc-component-section mc-typography-component" aria-labelledby="mc-table-system-title">
        <div class="mc-typography-hero">
            <span class="mc-typography-eyebrow">Component 05</span>
            <h2 id="mc-table-system-title" class="mc-typography-display">Data Tables</h2>
            <p class="mc-typography-lead">Admin tables keep filters in the header, scrollable table frames in the body, and result summaries with pagination in the footer.</p>
        </div>

        <section class="mc-card mc-card--table-design" aria-labelledby="mc-table-filter-title">
            <h3 id="mc-table-filter-title" class="sr-only">Table filter controls</h3>
            <div class="mc-card-header mc-table-design-controls">
                <div class="mc-table-design-controls__filters">
                    <div class="mc-toolbar mc-product-toolbar mc-table-design-toolbar mc-table-filter" role="search" aria-label="Table filter controls">
                        <div class="mc-product-toolbar__search">
                            <label class="mc-filter-label" for="mc-component-table-filter-search">Search</label>
                            <input class="mc-form-control" id="mc-component-table-filter-search" type="search" placeholder="Search Bundles" value="">
                        </div>
                        <div class="mc-product-toolbar__field">
                            <label class="mc-filter-label" for="mc-component-table-filter-type">Type</label>
                            <select class="mc-select" id="mc-component-table-filter-type">
                                <option selected>All Types</option>
                                <option>Course</option>
                                <option>Bundle</option>
                                <option>Program</option>
                            </select>
                        </div>
                        <div class="mc-product-toolbar__field">
                            <label class="mc-filter-label" for="mc-component-table-filter-status">Status</label>
                            <select class="mc-select" id="mc-component-table-filter-status">
                                <option selected>All Statuses</option>
                                <option>Published</option>
                                <option>Draft</option>
                                <option>Archived</option>
                            </select>
                        </div>
                        <div class="mc-product-toolbar__field">
                            <label class="mc-filter-label" for="mc-component-table-filter-date-range">Date Range</label>
                            <select class="mc-select" id="mc-component-table-filter-date-range">
                                <option selected>All Dates</option>
                                <option>Today</option>
                                <option>Last 7 Days</option>
                                <option>Last 30 Days</option>
                                <option>This Month</option>
                            </select>
                        </div>
                        <div class="mc-product-toolbar__field mc-product-toolbar__field--small mc-table-design-page-size">
                            <label class="mc-filter-label" for="mc-component-table-filter-perpage">Per Page</label>
                            <select class="mc-select" id="mc-component-table-filter-perpage">
                                <option selected>10</option>
                                <option>25</option>
                                <option>50</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="mc-card mc-card--table-design mc-product-listing-filter-card" aria-label="Product listing filter controls">
            <div class="mc-card-header mc-table-design-controls mc-product-listing-header">
