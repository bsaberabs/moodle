# Copiez ce fichier en .env puis changez les mots de passe.

# URL publique exacte du site (sans / final). En local : http://localhost:8080
MOODLE_WWWROOT=http://localhost:8080
# En production :
# MOODLE_WWWROOT=https://oriskill.com
MOODLE_HTTP_PORT=8080
# true si un reverse proxy HTTPS est placé devant Moodle (production)
MOODLE_SSLPROXY=false

MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=ChangeMoi-DB-2026!
MYSQL_ROOT_PASSWORD=ChangeMoi-Root-2026!

MOODLE_LANG=fr
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=ChangeMoi-Admin-2026!
MOODLE_ADMIN_EMAIL=admin@oriskill.com
# Nom complet : affiché dans les titres de page, avec les mots-clés pour le référencement
MOODLE_SITE_FULLNAME=Oriskill – Formations en ligne pratiques : IA, numérique et compétences pro
MOODLE_SITE_SHORTNAME=Oriskill

# E-mails. En local, Mailpit capture tout : http://localhost:8025
COMPOSE_PROFILES=mail-test
MOODLE_SMTP_HOST=mailpit:1025
MOODLE_NOREPLY_ADDRESS=noreply@oriskill.com
MOODLE_SUPPORT_EMAIL=support@oriskill.com
# En production : supprimer COMPOSE_PROFILES et indiquer le vrai serveur SMTP, par exemple
# MOODLE_SMTP_HOST=mail.infomaniak.com:587
# MOODLE_SMTP_SECURE=tls
# MOODLE_SMTP_USER=noreply@oriskill.com
# MOODLE_SMTP_PASSWORD=...

# En production : image publiée par la CI (mise à jour automatiquement au déploiement)
# MOODLE_IMAGE=ghcr.io/bsaberabs/moodle:latest
